{
  "name": "@factory/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.jsx",
    "./lib/*": "./src/lib/*.js",
    "./hooks/*": "./src/hooks/*.js"
  },
  "imports": {
    "#components/*": "./src/components/*.jsx",
    "#hooks/*": "./src/hooks/*.js",
    "#lib/*": "./src/lib/*.js",
    "#status-message": "./src/status-message.jsx"
  },
  "scripts": {
    "build": "storybook build",
    "dev": "storybook dev --host 0.0.0.0 --port 6006",
    "lint": "prettier --check .",
    "package:pages": "node scripts/package-pages-artifact.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.468.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "10.5.8",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "axe-core": "4.11.0",
    "eslint": "9.39.1",
    "eslint-plugin-storybook": "10.5.8",
    "jsdom": "26.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "storybook": "10.5.8",
    "tailwindcss": "^4.1.18",
    "vite": "7.2.6",
    "vitest": "4.1.11"
  }
