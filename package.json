{
  "name": "factory",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format:check": "prettier --check $(git ls-files -- \"*.js\" \"*.jsx\" \"*.mjs\" \"*.json\" \"*.md\" \"*.yml\" \"*.yaml\" \"*.css\")",
    "format:write": "prettier --write $(git ls-files -- \"*.js\" \"*.jsx\" \"*.mjs\" \"*.json\" \"*.md\" \"*.yml\" \"*.yaml\" \"*.css\")",
    "check": "pnpm format:check && turbo run lint test build"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "2.114.0",
    "turbo": "2.10.9"
  }
}
