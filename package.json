{
  "name": "factory",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "pnpm format:check && turbo run lint typecheck test build"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "supabase": "2.114.0",
    "turbo": "2.10.9",
    "typescript": "7.0.2"
  }
}
