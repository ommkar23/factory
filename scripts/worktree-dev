#!/usr/bin/env bash
set -Eeuo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
runtime_dir="$root/.hermes/runtime"
worktree_hash=$(node -e 'process.stdout.write(require("node:crypto").createHash("sha256").update(process.argv[1]).digest("hex").slice(0, 10))' "$root")
project="factory-${worktree_hash}"
ledger="$runtime_dir/${worktree_hash}.env"
factory_url=""
storybook_url=""
supabase_url=""
factory_alias=""
storybook_alias=""
supabase_alias=""
supabase_env_owned=false
api_env_owned=false
tailscale_requested=${FACTORY_TAILSCALE_SERVE:-false}
tailscale_factory_port=""
tailscale_storybook_port=""
tailscale_factory_target=""
tailscale_storybook_target=""
tailscale_factory_previous_target=""
tailscale_storybook_previous_target=""
tailscale_factory_url=""
tailscale_storybook_url=""

compose() {
  COMPOSE_PROJECT_NAME="$project" docker compose --project-name "$project" "$@"
}

require_commands() {
  for command in docker node portless python3; do
    command -v "$command" >/dev/null || {
      echo "$command is required." >&2
      return 1
    }
  done
  docker compose version >/dev/null
  if [[ "$tailscale_requested" == true ]]; then
    for command in tailscale flock; do
      command -v "$command" >/dev/null || {
        echo "$command is required for --tailscale." >&2
        return 1
      }
    done
  fi
}

load_ledger() {
  if [[ -f "$ledger" ]]; then
    # The ledger is generated by write_ledger with shell-escaped values.
    # shellcheck disable=SC1090
    source "$ledger"
  fi
}

portless_url() {
  portless get "$1"
}

alias_from_url() {
  node -e '
    const hostname = new URL(process.argv[1]).hostname;
    if (!hostname.endsWith(".localhost")) {
      throw new Error("Factory worktree aliases require Portless to use .localhost");
    }
    process.stdout.write(hostname.slice(0, -".localhost".length));
  ' "$1"
}

published_port() {
  local mapping
  mapping=$(compose port "$1" "$2")
  printf '%s\n' "${mapping##*:}"
}

write_ledger() {
  mkdir -p "$runtime_dir"
  umask 077
  {
    printf 'project=%q\n' "$project"
    printf 'factory_url=%q\n' "$factory_url"
    printf 'storybook_url=%q\n' "$storybook_url"
    printf 'supabase_url=%q\n' "$supabase_url"
    printf 'factory_alias=%q\n' "$factory_alias"
    printf 'storybook_alias=%q\n' "$storybook_alias"
    printf 'supabase_alias=%q\n' "$supabase_alias"
    printf 'supabase_env_owned=%q\n' "$supabase_env_owned"
    printf 'api_env_owned=%q\n' "$api_env_owned"
    printf 'tailscale_factory_port=%q\n' "$tailscale_factory_port"
    printf 'tailscale_storybook_port=%q\n' "$tailscale_storybook_port"
    printf 'tailscale_factory_target=%q\n' "$tailscale_factory_target"
    printf 'tailscale_storybook_target=%q\n' "$tailscale_storybook_target"
    printf 'tailscale_factory_previous_target=%q\n' "$tailscale_factory_previous_target"
    printf 'tailscale_storybook_previous_target=%q\n' "$tailscale_storybook_previous_target"
    printf 'tailscale_factory_url=%q\n' "$tailscale_factory_url"
    printf 'tailscale_storybook_url=%q\n' "$tailscale_storybook_url"
  } > "$ledger"
}

ensure_local_configuration() {
  load_ledger
  if [[ ! -f supabase/.env ]]; then
    supabase_env_owned=true
    umask 077
    cp supabase/.env.example supabase/.env
    (
      cd supabase
      ./utils/generate-keys.sh --update-env >/dev/null 2>&1
      ./utils/add-new-auth-keys.sh --update-env >/dev/null 2>&1
    )
  fi
  chmod 600 supabase/.env

  local publishable_key
  publishable_key=$(grep '^SUPABASE_PUBLISHABLE_KEY=' supabase/.env | cut -d= -f2-)
  if [[ -z "$publishable_key" ]]; then
    publishable_key=$(grep '^ANON_KEY=' supabase/.env | cut -d= -f2-)
  fi
  [[ -n "$publishable_key" ]] || {
    echo "No local Supabase publishable or anon key is configured." >&2
    return 1
  }

  if [[ ! -f services/api/.env ]]; then
    api_env_owned=true
    umask 077
    local session_key
    session_key=$(python3 -c 'import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())')
    printf 'SUPABASE_URL=http://api-gw:8000\nSUPABASE_PUBLISHABLE_KEY=%s\nAUTH_ALLOWED_RETURN_PATHS=/,/weather,/live-splash\nAUTH_SESSION_ENCRYPTION_KEY=%s\nAUTH_SESSION_DATABASE_URL=sqlite:////data/factory-api/sessions.db\n' "$publishable_key" "$session_key" > services/api/.env
    unset session_key
  fi

  ensure_api_env_value() {
    local name=$1 value=$2
    grep -q "^${name}=" services/api/.env || printf '%s=%s\n' "$name" "$value" >> services/api/.env
  }
  ensure_api_env_value DEV_AUTH_ENABLED true
  ensure_api_env_value DEV_AUTH_EMAIL factory-development@example.test
  if ! grep -q '^DEV_AUTH_PASSWORD=' services/api/.env; then
    ensure_api_env_value DEV_AUTH_PASSWORD "$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
  fi
  if ! grep -q '^DEV_AUTH_SECRET=' services/api/.env; then
    ensure_api_env_value DEV_AUTH_SECRET "$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
  fi
  chmod 600 services/api/.env

  export DEV_AUTH_SECRET
  DEV_AUTH_SECRET=$(grep '^DEV_AUTH_SECRET=' services/api/.env | cut -d= -f2-)
  [[ -n "$DEV_AUTH_SECRET" ]] || {
    echo "DEV_AUTH_SECRET is not configured." >&2
    return 1
  }
}

export_compose_environment() {
  factory_url=$(portless_url factory)
  storybook_url=$(portless_url storybook.factory)
  supabase_url=$(portless_url supabase.factory)
  factory_alias=$(alias_from_url "$factory_url")
  storybook_alias=$(alias_from_url "$storybook_url")
  supabase_alias=$(alias_from_url "$supabase_url")

  export FACTORY_PUBLIC_URL="$factory_url"
  export SUPABASE_PUBLIC_URL="$supabase_url"
  export API_EXTERNAL_URL="${supabase_url}/auth/v1"
  export SITE_URL="$factory_url"
  export ADDITIONAL_REDIRECT_URLS="${factory_url},${factory_url}/weather,${factory_url}/live-splash"
  export HOST_UID="$(id -u)"
  export HOST_GID="$(id -g)"
}

prepare_runtime_environment() {
  export_compose_environment
  export DEV_AUTH_SECRET
  if [[ -f services/api/.env ]]; then
    DEV_AUTH_SECRET=$(grep '^DEV_AUTH_SECRET=' services/api/.env | cut -d= -f2-)
  else
    DEV_AUTH_SECRET=cleanup-only
  fi
}

register_aliases() {
  local gateway_port storybook_port supabase_port
  gateway_port=$(published_port gateway 8080)
  storybook_port=$(published_port storybook 6006)
  supabase_port=$(published_port api-gw 8000)
  portless alias "$factory_alias" "$gateway_port" --force
  portless alias "$storybook_alias" "$storybook_port" --force
  portless alias "$supabase_alias" "$supabase_port" --force
}

remove_aliases() {
  for alias_name in "$factory_alias" "$storybook_alias" "$supabase_alias"; do
    [[ -n "$alias_name" ]] || continue
    portless alias --remove "$alias_name" >/dev/null 2>&1 || true
  done
}

tailscale_serve_status() {
  tailscale serve status --json 2>/dev/null
}

tailscale_proxy_for_port() {
  node scripts/worktree-tailscale.mjs proxy "$1" "$2"
}

reserved_tailscale_ports() {
  local candidate
  for candidate in "$runtime_dir"/*.env; do
    [[ -f "$candidate" ]] || continue
    grep -E '^tailscale_(factory|storybook)_port=[0-9]+$' "$candidate" | cut -d= -f2- || true
  done
}

register_tailscale_target() {
  local port=$1 target=$2 previous=${3:-} status current
  status=$(tailscale_serve_status) || {
    echo "Unable to read Tailscale Serve state; confirm Serve is enabled for this node." >&2
    return 1
  }
  current=$(tailscale_proxy_for_port "$port" "$status")
  if [[ -n "$current" && "$current" != "$target" && "$current" != "$previous" ]]; then
    echo "Tailscale Serve HTTPS port $port is owned by another route; refusing to replace $current." >&2
    return 1
  fi
  if [[ "$current" != "$target" ]]; then
    tailscale serve --https="$port" --bg "$target" >/dev/null
  fi
}

register_tailscale_routes() {
  [[ "$tailscale_requested" == true ]] || return 0
  mkdir -p "$runtime_dir"
  exec 9>"$runtime_dir/tailscale-serve.lock"
  flock 9

  local gateway_port storybook_port status reserved ports hostname
  gateway_port=$(published_port gateway 8080)
  storybook_port=$(published_port storybook 6006)
  tailscale_factory_previous_target=$tailscale_factory_target
  tailscale_storybook_previous_target=$tailscale_storybook_target
  tailscale_factory_target="http://127.0.0.1:${gateway_port}"
  tailscale_storybook_target="http://127.0.0.1:${storybook_port}"
  status=$(tailscale_serve_status) || {
    echo "Unable to read Tailscale Serve state; confirm Serve is enabled for this node." >&2
    return 1
  }

  if [[ -z "$tailscale_factory_port" || -z "$tailscale_storybook_port" ]]; then
    reserved=$(reserved_tailscale_ports | paste -sd, -)
    ports=$(node scripts/worktree-tailscale.mjs allocate "$worktree_hash" "$status" "$reserved")
    read -r tailscale_factory_port tailscale_storybook_port <<< "$ports"
  fi

  hostname=$(node scripts/worktree-tailscale.mjs hostname "$(tailscale status --json)")
  [[ -n "$hostname" ]] || {
    echo "Tailscale did not report a MagicDNS hostname for this node." >&2
    return 1
  }
  tailscale_factory_url="https://${hostname}:${tailscale_factory_port}"
  tailscale_storybook_url="https://${hostname}:${tailscale_storybook_port}"
  # Persist ownership before changing node-global Serve configuration so an
  # interrupted startup can safely recover only this worktree's routes.
  write_ledger
  register_tailscale_target "$tailscale_factory_port" "$tailscale_factory_target" "$tailscale_factory_previous_target"
  register_tailscale_target "$tailscale_storybook_port" "$tailscale_storybook_target" "$tailscale_storybook_previous_target"
  tailscale_factory_previous_target=""
  tailscale_storybook_previous_target=""
  write_ledger
  flock -u 9
}

remove_tailscale_target() {
  local port=$1 expected=$2 previous=${3:-} status current
  [[ -n "$port" && -n "$expected" ]] || return 0
  if ! command -v tailscale >/dev/null; then
    echo "tailscale is unavailable; preserving owned Serve HTTPS port $port." >&2
    return 0
  fi
  status=$(tailscale_serve_status) || {
    echo "Unable to inspect Tailscale Serve HTTPS port $port; preserving it." >&2
    return 0
  }
  current=$(tailscale_proxy_for_port "$port" "$status")
  if [[ "$current" == "$expected" || ( -n "$previous" && "$current" == "$previous" ) ]]; then
    tailscale serve --https="$port" off >/dev/null
  elif [[ -n "$current" ]]; then
    echo "Tailscale Serve HTTPS port $port no longer matches this worktree; preserving $current." >&2
  fi
}

remove_tailscale_routes() {
  [[ -n "$tailscale_factory_port" || -n "$tailscale_storybook_port" ]] || return 0
  if ! command -v tailscale >/dev/null || ! command -v flock >/dev/null; then
    echo "tailscale or flock is unavailable; preserving owned Serve routes." >&2
    return 0
  fi
  mkdir -p "$runtime_dir"
  exec 9>"$runtime_dir/tailscale-serve.lock"
  flock 9
  remove_tailscale_target "$tailscale_factory_port" "$tailscale_factory_target" "$tailscale_factory_previous_target"
  remove_tailscale_target "$tailscale_storybook_port" "$tailscale_storybook_target" "$tailscale_storybook_previous_target"
  flock -u 9
}

provision_dev_user() {
  local supabase_port service_role_key dev_auth_email dev_auth_password
  supabase_port=$(published_port api-gw 8000)
  service_role_key=$(grep '^SERVICE_ROLE_KEY=' supabase/.env | cut -d= -f2-)
  dev_auth_email=$(grep '^DEV_AUTH_EMAIL=' services/api/.env | cut -d= -f2-)
  dev_auth_password=$(grep '^DEV_AUTH_PASSWORD=' services/api/.env | cut -d= -f2-)
  for _ in {1..30}; do
    if SUPABASE_AUTH_URL="http://127.0.0.1:${supabase_port}/auth/v1" \
      SUPABASE_SERVICE_ROLE_KEY="$service_role_key" \
      DEV_AUTH_EMAIL="$dev_auth_email" \
      DEV_AUTH_PASSWORD="$dev_auth_password" \
      python3 scripts/provision-dev-auth-user.py; then
      return 0
    fi
    sleep 1
  done
  echo "Local Supabase development user provisioning failed." >&2
  return 1
}

wait_for_readiness() {
  local gateway_port storybook_port
  gateway_port=$(published_port gateway 8080)
  storybook_port=$(published_port storybook 6006)
  for _ in {1..60}; do
    if curl -fsS --max-time 5 "http://127.0.0.1:${gateway_port}/" >/dev/null &&
      curl -fsS --max-time 5 "http://127.0.0.1:${gateway_port}/weather" >/dev/null &&
      curl -fsS --max-time 5 "http://127.0.0.1:${gateway_port}/live-splash" >/dev/null &&
      curl -fsS --max-time 5 "http://127.0.0.1:${storybook_port}/" >/dev/null; then
      return 0
    fi
    sleep 5
  done
  echo "Development stack readiness timed out; inspect: scripts/worktree-dev logs" >&2
  return 1
}

clean() {
  load_ledger
  prepare_runtime_environment
  remove_tailscale_routes
  remove_aliases
  compose down --volumes --remove-orphans || true
  if [[ "$supabase_env_owned" == true ]]; then
    rm -f supabase/.env supabase/.env.old supabase/docker-compose.yml.old
  fi
  if [[ "$api_env_owned" == true ]]; then
    rm -f services/api/.env
  fi
  rm -f "$ledger"
}

up() {
  require_commands
  portless proxy start >/dev/null
  ensure_local_configuration
  export_compose_environment
  local completed=false
  trap 'if [[ "$completed" != true ]]; then clean; fi' EXIT INT TERM
  compose config >/dev/null
  compose up -d --build
  # Refresh Nginx's Docker DNS resolution after dependency recreation.
  compose up -d --no-deps --force-recreate gateway
  register_aliases
  provision_dev_user
  wait_for_readiness
  register_tailscale_routes
  write_ledger
  completed=true
  trap - EXIT INT TERM
  printf 'Factory:   %s\nStorybook: %s\nSupabase:  %s\n' "$factory_url" "$storybook_url" "$supabase_url"
  if [[ -n "$tailscale_factory_url" ]]; then
    printf 'Tailnet Factory:   %s\nTailnet Storybook: %s\n' "$tailscale_factory_url" "$tailscale_storybook_url"
  fi
}

status() {
  load_ledger
  prepare_runtime_environment
  compose ps
  if [[ -f "$ledger" ]]; then
    printf 'Factory:   %s\nStorybook: %s\nSupabase:  %s\n' "$factory_url" "$storybook_url" "$supabase_url"
    if [[ -n "$tailscale_factory_url" ]]; then
      printf 'Tailnet Factory:   %s\nTailnet Storybook: %s\n' "$tailscale_factory_url" "$tailscale_storybook_url"
    fi
  fi
}

logs() {
  prepare_runtime_environment
  compose logs --follow "${@:2}"
}

if [[ "${2:-}" == "--tailscale" ]]; then
  tailscale_requested=true
elif [[ -n "${2:-}" && "${1:-}" != "logs" ]]; then
  echo "Unknown option: ${2}" >&2
  exit 2
fi

case "${1:-}" in
  up) up ;;
  status) status ;;
  logs) logs "$@" ;;
  clean) require_commands; clean ;;
  *) echo "Usage: scripts/worktree-dev <up [--tailscale]|status|logs|clean>" >&2; exit 2 ;;
esac
