# Local Compose uses ENVIRONMENT=development. Production must set every value below.
# Never expose these values through browser environment variables or return OAuth tokens to clients.
ENVIRONMENT=production
CORS_ALLOW_ORIGINS=https://factory.example
SUPABASE_URL=https://project-ref.supabase.co
# Optional browser-facing Supabase authorization origin. Defaults to SUPABASE_URL when omitted.
SUPABASE_AUTHORIZATION_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_PUBLIC_URL=https://factory.example
AUTH_ALLOWED_RETURN_PATHS=/,/weather,/live-splash
# Generate a unique 32-byte url-safe base64 Fernet key and keep it secret.
AUTH_SESSION_ENCRYPTION_KEY=replace-with-a-secret-fernet-key
# Production requires a PostgreSQL URL; Compose development may use sqlite:////data/factory-api/sessions.db.
AUTH_SESSION_DATABASE_URL=postgresql://factory:replace-with-a-secret@database.example/factory?sslmode=require
