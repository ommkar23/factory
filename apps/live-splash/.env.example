# Factory Live Splash public configuration.
# Values in this file are placeholders only. Do not commit .env.local or secrets.

# Set to true when Live Splash is built behind factory.markagen.ai/live-splash.
# This enables Next.js's /live-splash basePath; leave false for independent hosting.
FACTORY_SHARED_ORIGIN=false

# Required. Never put a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase Auth redirect URLs to allow:
# http://localhost:3000/auth/callback
# https://factory.markagen.ai/auth/callback
