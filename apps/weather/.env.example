# Factory Weather server configuration. Do not commit .env.local or secrets.
# None of these names are browser-exposed NEXT_PUBLIC_ variables.

# Set to true when Weather is built behind factory.markagen.ai/weather.
FACTORY_SHARED_ORIGIN=false

# Server-to-server Factory API origin. The browser uses same-origin /auth/* and /app/*.
FACTORY_API_URL=http://localhost:3004

# Local development only. setup-factory-dev.sh writes a random value to ignored
# .env.local; it is read only by the Next.js bootstrap route and is never public.
DEV_AUTH_SECRET=replace-with-the-local-api-dev-auth-secret

# Standalone Factory Home destination. This is server-only and defaults to http://localhost:3002.
FACTORY_HOME_URL=http://localhost:3002
