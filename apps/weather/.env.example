# Factory Weather public configuration.
# Values in this file are placeholders only. Do not commit .env.local or secrets.

# AUTH_MODE=mock is supported only by `next dev` (NODE_ENV=development).
# Set AUTH_MODE=supabase for every production build and deployment.
AUTH_MODE=mock

# Set to true when Weather is built behind factory.markagen.ai/weather.
# This enables Next.js's /weather basePath; leave false for independent hosting.
FACTORY_SHARED_ORIGIN=false

# Required only when AUTH_MODE=supabase. Never put a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase Auth redirect URLs to allow:
# http://localhost:3001/auth/callback
# https://factory.markagen.ai/weather/auth/callback
