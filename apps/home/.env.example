# Factory Home public configuration.
# Values in this file are placeholders only. Do not commit .env.local or secrets.

# Use mock for local development. Use supabase only for hosted deployments.
# AUTH_MODE=mock is supported only by `next dev` (NODE_ENV=development).
# Set AUTH_MODE=supabase for every production build and deployment.
AUTH_MODE=mock

# Required only when AUTH_MODE=supabase. These are the Supabase project URL and
# publishable key; never use a service-role or secret key in a Next.js app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional public URLs for Factory Home app links. Both must be absolute URLs.
LIVE_SPLASH_URL=https://live-splash.example.com
WEATHER_URL=https://weather.example.com

# Supabase Auth redirect URLs to allow:
# http://localhost:3002/auth/callback
# https://factory.markagen.ai/auth/callback
